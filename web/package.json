{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"test": "bun test test/auth-pages.test.ts test/vault-crypto.test.ts test/hotkeys.test.ts test/device-approval.test.ts",
		"dev:test": "bun test/dev-server.ts",
		"test:integration": "bun test/workspaces.integration.ts && bun test/invitations.integration.ts",
		"test:browser": "bun test/browser.integration.ts"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.4",
		"@types/pg": "^8.23.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"bits-ui": "^2.19.4",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.3",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"remixicon-svelte": "^0.0.5",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.2"
	},
	"dependencies": {
		"@better-auth/passkey": "1.7.7",
		"@fontsource-variable/geist": "^5.3.0",
		"better-auth": "^1.7.7",
		"mode-watcher": "^1.1.0",
		"pg": "^8.23.1",
		"postgres": "^3.4.9",
		"runed": "^0.35.1",
		"zod": "^4.6.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"overrides": {
		"defu": "^6.1.7",
		"esbuild": "^0.28.2"
	}
}
